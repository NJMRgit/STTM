#!/bin/sh

# some env vars that are needed for kwin effects to work
export XDG_SESSION_TYPE=wayland
export XDG_RUNTIME_DIR=/run/user/$(id -u)
export XDG_CONFIG_DIRS=/home/$(id -un)/.config/kdedefaults:/etc/xdg
export LIBGL_ALWAYS_REDIRECT=
export QT_WAYLAND_RECONNECT=1


#-------------------------------------------------------------------------------------------------#
# set the hours for auto mode
MORNING_HOUR="6"
NOON_HOUR="12"
AFTERNOON_HOUR="14"
EVENING_HOUR="17"
NIGHT_HOUR="21"
#-------------------------------------------------------------------------------------------------#
#IMPORTANT#
# $TINT values need to be in hex w/ alpha (ex: #00112233)
# OUTLINE_COLOR and SHADOW_COLOR need to be in RGB (ex: 225,225,225)
#-------------------------------------------------------------------------------------------------#
#-------------------------------------------------------------------------------------------------#
# morning mode settings
MORNING_TINT=
MORNING_OUTLINE_COLOR_ACTIVE=
MORNING_OUTLINE_COLOR_INACTIVE=
MORNING_SHADOW_COLOR=
MORNING_SHADOW_COLOR_INACTIVE=
MORNING_WALLPAPER=
MORNING_FF_LOGO=
MORNING_FF_LOGO_COLOR=
MORNING_RGB=
MORNING_KB_COLOR=
#-------------------------------------------------------------------------------------------------#
#-------------------------------------------------------------------------------------------------#
# noon mode settings
NOON_TINT=
NOON_OUTLINE_COLOR_ACTIVE=
NOON_OUTLINE_COLOR_INACTIVE=
NOON_SHADOW_COLOR=
NOON_SHADOW_COLOR_INACTIVE=
NOON_WALLPAPER=
NOON_FF_LOGO=
NOON_FF_LOGO_COLOR=
NOON_RGB=
NOON_KB_COLOR=
#-------------------------------------------------------------------------------------------------#
#-------------------------------------------------------------------------------------------------#
# afternoon mode settings
AFTERNOON_TINT=
AFTERNOON_OUTLINE_COLOR_ACTIVE=
AFTERNOON_OUTLINE_COLOR_INACTIVE=
AFTERNOON_SHADOW_COLOR=
AFTERNOON_SHADOW_COLOR_INACTIVE=
AFTERNOON_WALLPAPER=
AFTERNOON_FF_LOGO=
AFTERNOON_FF_LOGO_COLOR=
AFTERNOON_RGB=
AFTERNOON_KB_COLOR=
#-------------------------------------------------------------------------------------------------#
#-------------------------------------------------------------------------------------------------#
# evening mode settings
EVENING_TINT=
EVENING_OUTLINE_COLOR_ACTIVE=
EVENING_OUTLINE_COLOR_INACTIVE=
EVENING_SHADOW_COLOR=
EVENING_SHADOW_COLOR_INACTIVE=
EVENING_WALLPAPER=
EVENING_FF_LOGO=
EVENING_FF_LOGO_COLOR=
EVENING_RGB=
EVENING_KB_COLOR=
#-------------------------------------------------------------------------------------------------#
#-------------------------------------------------------------------------------------------------#
# night mode settings
NIGHT_TINT=
NIGHT_OUTLINE_COLOR_ACTIVE=
NIGHT_OUTLINE_COLOR_INACTIVE=
NIGHT_SHADOW_COLOR=
NIGHT_SHADOW_COLOR_INACTIVE=
NIGHT_WALLPAPER=
NIGHT_FF_LOGO=
NIGHT_FF_LOGO_COLOR=
NIGHT_RGB=
NIGHT_KB_COLOR=
#-------------------------------------------------------------------------------------------------#

#get time
h=$(date +%H)

[ -z "$HOME" ] && HOME=/tmp/
# runtime state for the deferred Yakuake reload watcher (pidfile + log).
# This sits below "#get time" on purpose: the installer's merge keeps an existing
# config header and replaces everything under "#get time", so a definition in the
# header would never reach an upgraded install.
# XDG_RUNTIME_DIR is wiped at logout, so a stale pidfile cannot survive a reboot.
# BLSW_STATE_DIR may be preset (tests, alternate profiles); the value is exported
# so the detached watcher resolves the same pidfile and log.
BLSW_STATE_DIR="${BLSW_STATE_DIR:-${XDG_RUNTIME_DIR:-/tmp}/blsw}"
export BLSW_STATE_DIR
BLSW_WATCH_PIDFILE="$BLSW_STATE_DIR/yakuake-watch.pid"
BLSW_WATCH_LOG="$BLSW_STATE_DIR/yakuake-watch.log"


# fix mode - rebuild and reload effects
if [ "$1" = "--fix" ]; then
    yay -S kwin-effects-glass-git --rebuild
    yay -S kwin-effect-rounded-corners-git --rebuild
    kquitapp6 plasmashell
    kstart plasmashell
    qdbus6 --literal org.kde.KWin /Effects org.kde.kwin.Effects.unloadEffect glass
    qdbus6 --literal org.kde.KWin /Effects org.kde.kwin.Effects.loadEffect glass
    qdbus6 --literal org.kde.KWin /Effects org.kde.kwin.Effects.unloadEffect kwin4_effect_shapecorners
    qdbus6 --literal org.kde.KWin /Effects org.kde.kwin.Effects.loadEffect kwin4_effect_shapecorners
    exit 0
fi

# --- Yakuake reload watcher (hidden mode) ------------------------------------
# `blsw --yakuake-watch <session-id> [mode]` is the detached worker started at
# the end of a themed run (see the Yakuake block near the bottom). It waits for
# the Yakuake session to become idle and then reloads it, but it does the
# waiting in its own session, so the command that changed the theme (and the
# sttm GUI that may have started it) returns immediately.
# It re-executes this very file, which keeps blsw one portable script: there is
# no helper file to install next to it.
if [ "$1" = "--yakuake-watch" ]; then
    WATCH_SESSION="$2"
    WATCH_MODE="$3"
    # token of the run that started us. A later theme change kills this watcher
    # and overwrites the token; if the kill raced the spawn, the token check in
    # the loop retires us instead.
    WATCH_TOKEN="$4"
    WATCH_POLL="${BLSW_YAKUAKE_POLL:-1}"      # seconds between idle checks
    WATCH_MAX="${BLSW_YAKUAKE_MAX_WAIT:-0}"   # seconds; 0 = wait until idle
    WATCH_GRACE=5                             # polls before a failed scan counts

    wlog() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

    case "$WATCH_SESSION" in
        ''|*[!0-9]*) wlog "no Yakuake session id given, exiting"; exit 1 ;;
    esac
    [ -n "$WATCH_TOKEN" ] || WATCH_TOKEN="standalone-$$"

    mkdir -p "$BLSW_STATE_DIR" 2>/dev/null || exit 1
    # pidfile line 1 = token of the newest theme change, line 2 = our pid
    watch_file_token() { sed -n '1p' "$BLSW_WATCH_PIDFILE" 2>/dev/null; }
    watch_superseded() {
        t=$(watch_file_token)
        [ -n "$t" ] && [ "$t" != "$WATCH_TOKEN" ]
    }
    if watch_superseded; then
        wlog "superseded before start, exiting"
        exit 0
    fi
    printf '%s\n%s\n' "$WATCH_TOKEN" "$$" > "$BLSW_WATCH_PIDFILE"

    # is the session we were started for still there? (exit instead of removing
    # a session id that was closed by hand and could be reused)
    # sessionIdList is a single QString ("1", "1, 2", ...): keep every number,
    # whatever the separator, so a session count change cannot break the match
    watch_session_exists() {
        qdbus6 org.kde.yakuake /yakuake/sessions sessionIdList 2>/dev/null \
            | tr -cs '0-9' '\n' | grep -qx "$WATCH_SESSION"
    }

    # the /dev/pts of the Yakuake terminal (Yakuake exposes no pid or tty over
    # D-Bus, so walk the process trees and take the first pts owned by Yakuake)
    watch_find_pty() {
        for p in /dev/pts/*; do
            [ -e "$p" ] || continue
            pid=$(ps -t "${p##*/}" -o pid= 2>/dev/null | head -1)
            [ -n "$pid" ] || continue
            if pstree -s "$pid" 2>/dev/null | grep -q yakuake; then
                printf '%s\n' "${p##*/}"
                return 0
            fi
        done
        return 1
    }

    # a plain login shell means the session is sitting at a prompt
    watch_pty_busy() {
        ps -t "$1" -o comm= 2>/dev/null \
            | grep -v -E '^(bash|zsh|fish|sh|dash|ksh|tcsh)$' | grep -q .
    }

    watch_reload() {
        wlog "reloading Yakuake session $WATCH_SESSION${WATCH_MODE:+ (mode $WATCH_MODE)}: $1"
        qdbus6 org.kde.yakuake /yakuake/sessions removeSession "$WATCH_SESSION" 2>/dev/null || true
    }

    wlog "watching Yakuake session $WATCH_SESSION${WATCH_MODE:+ (mode $WATCH_MODE)} for idle"
    WATCH_STARTED=$(date +%s)
    WATCH_MISSES=0
    while :; do
        if watch_superseded; then
            wlog "replaced by a newer theme change; exiting without reloading"
            break
        fi
        if ! watch_session_exists; then
            wlog "session $WATCH_SESSION is gone (Yakuake closed?); nothing to reload"
            break
        fi
        if WATCH_PTY=$(watch_find_pty); then
            WATCH_MISSES=0
            if ! watch_pty_busy "$WATCH_PTY"; then
                watch_reload "session idle on /dev/pts/$WATCH_PTY"
                break
            fi
        else
            # cannot see a Yakuake tty: a glitch must not cost a busy session,
            # so only act once the scan has failed repeatedly
            WATCH_MISSES=$((WATCH_MISSES + 1))
            if [ "$WATCH_MISSES" -ge "$WATCH_GRACE" ]; then
                watch_reload "no Yakuake tty found"
                break
            fi
        fi
        if [ "$WATCH_MAX" -gt 0 ] 2>/dev/null && \
           [ $(( $(date +%s) - WATCH_STARTED )) -ge "$WATCH_MAX" ]; then
            wlog "session $WATCH_SESSION still busy after ${WATCH_MAX}s; leaving it alone"
            break
        fi
        sleep "$WATCH_POLL"
    done
    # only drop the pidfile while it is still ours (a replacement owns it now)
    [ "$(watch_file_token)" = "$WATCH_TOKEN" ] && rm -f "$BLSW_WATCH_PIDFILE"
    exit 0
fi

# Allow manual mode selection with flags
MODE="$_MODE"

if [ -z "$1" ]; then
	scriptname=$(basename "$0")
	scheduled_modes="MORNING NOON AFTERNOON EVENING NIGHT"
	sorted=""
	for m in $scheduled_modes; do
		eval "h=\${${m}_HOUR}"
		sorted="$sorted$h:$m "
	done
	sorted=$(echo "$sorted" | tr ' ' '\n' | sort -n | cut -d: -f2 | tr '\n' ' ' | tr '[:upper:]' '[:lower:]')
	all_modes=$(grep -o '^[A-Z0-9_]*_TINT=' "$0" | sed 's/_TINT=//' | sort -u)
	custom=""
	for m in $all_modes; do
		case " $scheduled_modes " in *" $m "*) ;; *) custom="$custom $m" ;; esac
	done
	if [ -n "$custom" ]; then
		custom=$(echo "$custom" | tr '[:upper:]' '[:lower:]' | sort -u | tr '\n' ' ')
	fi
	printf '\033[36m'
	printf '██████╗ ██╗     ███████╗██╗    ██╗\n'
	printf '██╔══██╗██║     ██╔════╝██║    ██║\n'
	printf '██████╔╝██║     ███████╗██║ █╗ ██║\n'
	printf '██╔══██╗██║     ╚════██║██║███╗██║\n'
	printf '██████╔╝███████╗███████║╚███╔███╔╝\n'
	printf '╚═════╝ ╚══════╝╚══════╝ ╚══╝╚══╝ \n'
	printf '\033[0m'
	printf 'Blur Switch - Stoned Theme Manager Control Script\n'
	printf '\033[2m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n'
	printf '\n'
	printf 'usage:      %s auto        #sets mode according to time\n' "$scriptname"
	printf '            %s morning     #sets mode to morning\n' "$scriptname"
	printf '\n'
	printf '     Note:The script can be renamed to whatever you like and placed anywhere.\n'
	printf '          If using the GUI and there is no blsw script in the same directory\n'
	printf '          it will ask for the script location on first launch\n'
	printf '\n'
	printf '  [Scheduled modes] \n'
	printf '\n'
	for m in $sorted; do
		eval "h=\${$(echo "$m" | tr '[:lower:]' '[:upper:]')_HOUR}"
		printf '  %-12s (%s:00)\n' "$m" "$h"
	done
	if [ -n "$custom" ]; then
		printf '\n'
		printf '  [Custom Modes]    \n'
		printf '\n'
		for m in $custom; do
			printf '  %s\n' "$m"
		done
	fi
	printf '\n'
	exit 0
fi

# Load previous mode BEFORE determining new mode
_MODE="auto"
[ -f "$HOME/.blur-schedule" ] && . "$HOME/.blur-schedule"
PREVIOUS_MODE="$_MODE"

if [ ! -z "$1" ]; then
	MODE="$1"
fi

# determine current time-based mode
if [ "$h" -ge "$NIGHT_HOUR" ] || [ "$h" -lt "$MORNING_HOUR" ]; then
    CURRENT_MODE="night"
elif [ "$h" -ge "$EVENING_HOUR" ]; then
    CURRENT_MODE="evening"
elif [ "$h" -ge "$AFTERNOON_HOUR" ]; then
    CURRENT_MODE="afternoon"
elif [ "$h" -ge "$NOON_HOUR" ]; then
    CURRENT_MODE="noon"
elif [ "$h" -ge "$MORNING_HOUR" ]; then
    CURRENT_MODE="morning"
fi

# handle auto mode
if [ "$MODE" = "auto" ] || [ "$MODE" = "smart" ]; then
	MODE="auto"
	ACTIVE_MODE="$CURRENT_MODE"
else
	ACTIVE_MODE="$MODE"
fi

# Check if mode actually changed
MODE_CHANGED=false
if [ "$_MODE" != "$ACTIVE_MODE" ] && [ "$_MODE" != "auto" ]; then
	MODE_CHANGED=true
elif [ "$_MODE" = "auto" ] && [ "$ACTIVE_MODE" != "$CURRENT_MODE" ]; then
	MODE_CHANGED=true
fi

# read active mode values; empty vars are left unapplied so prior/manual values persist
MODE_UPPER=$(echo "$ACTIVE_MODE" | tr '[:lower:]' '[:upper:]')

for var in TINT OUTLINE_COLOR_ACTIVE OUTLINE_COLOR_INACTIVE SHADOW_COLOR SHADOW_COLOR_INACTIVE WALLPAPER FF_LOGO FF_LOGO_COLOR RGB KB_COLOR; do
    eval "$var=\"\${${MODE_UPPER}_$var}\""
done

# nothing to change if all key vars are empty for this mode
if [ -z "$TINT" ] && [ -z "$OUTLINE_COLOR_ACTIVE" ] && [ -z "$OUTLINE_COLOR_INACTIVE" ] && \
   [ -z "$SHADOW_COLOR" ] && [ -z "$SHADOW_COLOR_INACTIVE" ] && \
   [ -z "$WALLPAPER" ] && [ -z "$FF_LOGO" ] && [ -z "$FF_LOGO_COLOR" ] && [ -z "$RGB" ] && [ -z "$KB_COLOR" ]; then
    exit 0
fi

# update glass variables
[ -n "$TINT" ] && kwriteconfig6 --file kwinrc --group Effect-blurplus --key TintColor $TINT

# update kde-rounded-corners shadow and outline variables
[ -n "$SHADOW_COLOR" ] && kwriteconfig6 --file kwinrc --group "Round-Corners" --key ShadowColor $SHADOW_COLOR
[ -n "$SHADOW_COLOR_INACTIVE" ] && kwriteconfig6 --file kwinrc --group "Round-Corners" --key InactiveShadowColor $SHADOW_COLOR_INACTIVE
[ -n "$OUTLINE_COLOR_ACTIVE" ] && kwriteconfig6 --file kwinrc --group "Round-Corners" --key OutlineColor $OUTLINE_COLOR_ACTIVE
[ -n "$OUTLINE_COLOR_INACTIVE" ] && kwriteconfig6 --file kwinrc --group "Round-Corners" --key InactiveOutlineColor $OUTLINE_COLOR_INACTIVE
[ -n "$OUTLINE_COLOR_ACTIVE" ] && kwriteconfig6 --file kwinrc --group "Round-Corners" --key SecondOutlineColor $OUTLINE_COLOR_ACTIVE
[ -n "$OUTLINE_COLOR_INACTIVE" ] && kwriteconfig6 --file kwinrc --group "Round-Corners" --key InactiveSecondOutlineColor $OUTLINE_COLOR_INACTIVE

# change openrgb profile
[ -n "$RGB" ] && openrgb -p "$RGB"

# keyboard colour (optional) - applies $KB_COLOR to supported keyboards via the kb-rgb helper.
# --mode is passed as well: with a symbolic $KB_COLOR (tint/logo/live) kb-rgb needs the
# mode explicitly, because ~/.blur-schedule still holds the PREVIOUS mode this early in
# the run (it is written at the end) and kb-rgb would otherwise pick that mode's colour.
[ -n "$KB_COLOR" ] && command -v kb-rgb >/dev/null 2>&1 && kb-rgb --mode "$ACTIVE_MODE" --rgb "$KB_COLOR"

# apply wallpaper & fastfetch logo
[ -n "$WALLPAPER" ] && plasma-apply-wallpaperimage "$WALLPAPER"

# locate fastfetch config - defer to fastfetch's own resolution
FF_CONFIG=""
if [ -n "$FASTFETCH_CONFIG_PATH" ]; then
    [ -f "$FASTFETCH_CONFIG_PATH" ] && FF_CONFIG="$FASTFETCH_CONFIG_PATH"
elif command -v fastfetch >/dev/null 2>&1; then
    FF_CONFIG=$(fastfetch --list-config-paths 2>/dev/null | head -1)
    [ -f "$FF_CONFIG" ] || FF_CONFIG=""
fi
# fallback: check standard paths in fastfetch order
if [ -z "$FF_CONFIG" ]; then
    for d in "${XDG_CONFIG_HOME:-$HOME/.config}" "/etc"; do
        for f in "$d/fastfetch/config.jsonc" "$d/fastfetch/config.json"; do
            [ -f "$f" ] && FF_CONFIG="$f" && break 2
        done
    done
fi

# create config if none exists, so logo settings can still be applied
if [ -z "$FF_CONFIG" ]; then
    FF_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/config.jsonc"
    mkdir -p "$(dirname "$FF_CONFIG")"
    if command -v fastfetch >/dev/null 2>&1; then
        fastfetch --gen-config 2>/dev/null || true
    fi
    if [ ! -f "$FF_CONFIG" ]; then
        cat > "$FF_CONFIG" <<- 'EOF'
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "",
        "color": { "1": "" }
    }
}
EOF
    fi
fi

[ -n "$FF_LOGO" ] && EXTRA_JQ=".logo.source = \"$FF_LOGO\" |"
[ -n "$FF_LOGO_COLOR" ] && EXTRA_JQ="${EXTRA_JQ} .logo.color = { \"1\": \"$FF_LOGO_COLOR\" } |"
if [ -n "$FF_LOGO" ] || [ -n "$FF_LOGO_COLOR" ]; then
    # parse JSONC -> JSON, apply jq, write back as JSON (valid JSONC)
    python3 -c "
import json, re, sys
with open(sys.argv[1]) as f:
    text = f.read()
# strip block comments
text = re.sub(r'/\*.*?\*/', '', text, flags=re.DOTALL)
# strip single-line comments (track string state to avoid breaking URLs)
lines = text.split('\n')
clean = []
for line in lines:
    out = ''
    in_str = False
    esc = False
    for i, c in enumerate(line):
        if esc:           esc = False; out += c; continue
        if c == '\\\\':   esc = True;  out += c; continue
        if c == '\"':     in_str = not in_str
        if not in_str and c == '/' and i+1 < len(line) and line[i+1] == '/': break
        out += c
    clean.append(out)
text = '\n'.join(clean)
# remove trailing commas
text = re.sub(r',(\s*[}\]])', r'\1', text)
data = json.loads(text)
json.dump(data, sys.stdout, indent=4)
" "$FF_CONFIG" | jq "${EXTRA_JQ%|}" > tmp.json && mv tmp.json "$FF_CONFIG"
fi

# reload kwin effects (fixes issue with some effects not updating correctly)
qdbus6 org.kde.KWin /Effects reconfigureEffect glass #update glass config
qdbus6 --literal org.kde.KWin /Effects org.kde.kwin.Effects.unloadEffect kwin4_effect_shapecorners #unload rounded-corners so colors update properly
qdbus6 --literal org.kde.KWin /Effects org.kde.kwin.Effects.loadEffect kwin4_effect_shapecorners #reload rounded-corners

# Save current mode
echo "_MODE=$ACTIVE_MODE" > "$HOME/.blur-schedule"

echo "Applied $ACTIVE_MODE mode settings"

# Update pyroclear's saved palette with the theme gradient (config only - no terminal paint).
# The next plain `pyroclear` run burns with these colors.
# Use `blsw <mode> --paint` to also paint the current terminal right away.
if command -v pyroclear >/dev/null 2>&1; then
    PYRO_HEX="${TINT#\#}"
    PYRO_HEX="${PYRO_HEX#??}"  # TINT is #AARRGGBB -> strip alpha, keep RRGGBB
    if [ -n "$PYRO_HEX" ] && [ "${#PYRO_HEX}" -eq 6 ]; then
        # real gradient: darker shade of the theme color -> theme color
        PR=$((0x${PYRO_HEX:0:2})); PG=$((0x${PYRO_HEX:2:2})); PB=$((0x${PYRO_HEX:4:2}))
        PR=$((PR*35/100)); PG=$((PG*35/100)); PB=$((PB*35/100))
        PYRO_FROM=$(printf '#%02X%02X%02X' "$PR" "$PG" "$PB")
        PYRO_TO="#$PYRO_HEX"
        python3 - "$PYRO_FROM" "$PYRO_TO" <<'PYEOF'
import os, sys
xdg = os.environ.get("XDG_CONFIG_HOME")
base = os.path.join(xdg, "pyroclear") if xdg else os.path.join(os.environ.get("HOME", "/tmp"), ".config", "pyroclear")
path = os.path.join(base, "config.toml")
anim = {"fps": 60, "wind": 0, "height": 1, "direction": "false"}
try:
    for line in open(path):
        line = line.strip()
        if line.startswith(("[", "#")) or "=" not in line:
            continue
        k, _, v = line.partition("=")
        k, v = k.strip(), v.strip().strip('"')
        if k == "direction":
            if v.lower() in ("true", "false"):
                anim[k] = v.lower()
        elif v.lstrip("-").isdigit():
            n = int(v)
            if k == "fps":
                anim[k] = max(n, 1)
            elif k == "wind":
                anim[k] = max(-2, min(n, 2))
            elif k == "height":
                anim[k] = max(0, min(n, 3))
except FileNotFoundError:
    pass
os.makedirs(base, exist_ok=True)
with open(path, "w") as f:
    f.write(f'[color]\nfrom = "{sys.argv[1].lower()}"\nto = "{sys.argv[2].lower()}"\n\n')
    f.write("[animation]\n")
    f.write(f"fps       = {anim['fps']}\n")
    f.write(f"wind      = {anim['wind']}\n")
    f.write(f"height    = {anim['height']}\n")
    f.write(f"direction = {anim['direction']}\n")
PYEOF
        # opt-in: also paint the current terminal immediately
        if [ "$2" = "--paint" ]; then
            pyroclear --from "$PYRO_FROM" --to "$PYRO_TO"
        fi
    fi
fi

# --- Yakuake session reload (OPTIONAL) --------------------------------------
# Yakuake is NOT required: sttm works without it. This block only exists so an
# open Yakuake session picks up the new fastfetch logo, so it is skipped - with
# no D-Bus call at all - unless a Yakuake instance is actually running.
# Without this guard `qdbus6 org.kde.yakuake ...` fails on machines that do not
# run Yakuake and the GUI reports
#   "Script error: Service 'org.kde.yakuake' does not exist."
# pstree (psmisc) is only needed for this integration; if it is missing we skip
# instead of risking the close of a session that has a program running in it.
#
# The idle wait itself is NOT done here any more: it runs in the detached
# watcher (`blsw --yakuake-watch <id>`, defined near the top of this file), so a
# theme change returns at once instead of holding the calling terminal for up
# to 30s. A second theme change replaces the pending watcher - the watcher is
# started per run and stop_watcher kills the previous one first.
YAKUAKE_SESSION=""
yakuake_running() {
    command -v qdbus6 >/dev/null 2>&1 || return 1
    command -v pstree >/dev/null 2>&1 || return 1
    # activeSessionId only answers while a Yakuake instance is running
    YAKUAKE_SESSION=$(qdbus6 org.kde.yakuake /yakuake/sessions activeSessionId 2>/dev/null)
    case "$YAKUAKE_SESSION" in
        ''|*[!0-9]*) YAKUAKE_SESSION=""; return 1 ;;
    esac
    return 0
}

# absolute path of this script, so a detached watcher can re-exec it
blsw_script_path() {
    case "$0" in
        /*) printf '%s\n' "$0" ;;
        */*) printf '%s/%s\n' "$(cd "$(dirname "$0")" 2>/dev/null && pwd)" "$(basename "$0")" ;;
        *) command -v -- "$0" 2>/dev/null || printf '%s\n' "$0" ;;
    esac
}

# pid of a live watcher, or non-zero. pids get recycled, so the pidfile only
# counts while /proc/<pid>/cmdline still says --yakuake-watch.
# pidfile: line 1 = token of the newest theme change, line 2 = watcher pid.
blsw_watcher_pid() {
    pid=$(sed -n '2p' "$BLSW_WATCH_PIDFILE" 2>/dev/null)
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ -d "/proc/$pid" ] || return 1
    tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q -- '--yakuake-watch' || return 1
    printf '%s\n' "$pid"
}

# retire the watcher left over from an earlier theme change
blsw_stop_watcher() {
    pid=$(blsw_watcher_pid)
    if [ -n "$pid" ]; then
        kill "$pid" 2>/dev/null
        i=0
        while [ "$i" -lt 10 ] && [ -d "/proc/$pid" ]; do
            sleep 0.1
            i=$((i+1))
        done
        [ -d "/proc/$pid" ] && kill -9 "$pid" 2>/dev/null
    fi
    return 0
}

# start the detached watcher: new session (setsid), no controlling tty, stdio
# to the log, so closing the terminal cannot take it down. The pidfile is
# claimed with a fresh token before the spawn, so a watcher we failed to kill
# sees the new token and retires itself.
blsw_start_watcher() {   # $1 = session id
    BLSW_SELF=$(blsw_script_path)
    [ -n "$BLSW_SELF" ] || return 1
    mkdir -p "$BLSW_STATE_DIR" 2>/dev/null || return 1
    BLSW_TOKEN="$$-$(date +%s%N)"
    printf '%s\n\n' "$BLSW_TOKEN" > "$BLSW_WATCH_PIDFILE" 2>/dev/null || return 1
    setsid "$BLSW_SELF" --yakuake-watch "$1" "$ACTIVE_MODE" "$BLSW_TOKEN" </dev/null >>"$BLSW_WATCH_LOG" 2>&1 &
    return 0
}

if yakuake_running; then
    # Only close Yakuake session if the mode actually changed
    if [ "$MODE_CHANGED" = true ]; then
        if pstree -s $$ 2>/dev/null | grep -q yakuake; then
            echo "Running inside Yakuake, removing current session for reload"
            qdbus6 org.kde.yakuake /yakuake/sessions removeSession "$YAKUAKE_SESSION" 2>/dev/null || true
        else
            # deferred: the watcher waits for idle in the background
            blsw_stop_watcher
            if blsw_start_watcher "$YAKUAKE_SESSION"; then
                echo "Mode changed, Yakuake session will be reloaded when idle (log: $BLSW_WATCH_LOG)"
            else
                echo "Mode changed, but the Yakuake reload watcher could not be started"
            fi
        fi
    else
        if blsw_watcher_pid >/dev/null 2>&1; then
            echo "Mode unchanged, keeping the pending Yakuake reload watcher"
        else
            echo "Mode unchanged, skipping Yakuake session restart"
        fi
    fi
fi

# Exit cleanly: the sttm GUI treats a non-zero exit as a script error.
exit 0

